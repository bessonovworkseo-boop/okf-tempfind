{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://tempfind.com/#faq",
  "inLanguage": "en-CA",
  "dateModified": "2026-11-12",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Tempfind?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tempfind is an online platform, operated by Tempfind Inc. in Ontario, that connects dental clinics in Canada with temporary dental professionals. Clinics post shifts or book professionals directly, and professionals apply to shifts or accept booking requests. See Tempfind Inc.."
      }
    },
    {
      "@type": "Question",
      "name": "Is Tempfind a temp dental agency?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Tempfind describes itself as a marketplace where clinics and professionals connect directly. Its Terms of Use state that it is not an employer of professionals and not an employment or recruitment agency for any professional."
      }
    },
    {
      "@type": "Question",
      "name": "Which dental roles can clinics book on Tempfind?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Registered dental hygienists, dental assistants, dental receptionists, dentists (DDS), dental office managers, dental floaters and sedation or general nurses (RN). See Roles."
      }
    },
    {
      "@type": "Question",
      "name": "How does a clinic book a temporary dental professional?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The clinic either posts a shift and accepts an applicant, or searches the professional pool and sends a booking request. The first professional to accept a request gets the shift. See How Tempfind works."
      }
    },
    {
      "@type": "Question",
      "name": "How much does Tempfind cost for clinics?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pay Per Shift costs $49 per completed shift. Business costs $149 per month per location with a 12-month term and no placement fees. Enterprise is custom. A 3.9% payment handling fee applies to each shift total. See Clinic plans and fees."
      }
    },
    {
      "@type": "Question",
      "name": "Is Tempfind free for dental professionals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Creating a profile and applying to shifts is free for professionals. Clinics pay the platform fees."
      }
    },
    {
      "@type": "Question",
      "name": "Who sets the hourly rate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Professionals set their own hourly rate in their profile. Clinics see the rate before confirming a booking, and each job posting lists its offered pay."
      }
    },
    {
      "@type": "Question",
      "name": "How are professionals verified?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tempfind staff manually review each professional's credentials, certifications, education and documents after registration, with identity and security checks where the profession requires them. Professionals cannot apply or be booked until verified. See Professional verification."
      }
    },
    {
      "@type": "Question",
      "name": "How do clinics pay for shifts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "By credit card through Tempfind, processed by Stripe. From January 1, 2026, all clinics use Tempfind card processing. See Payments and payouts."
      }
    },
    {
      "@type": "Question",
      "name": "When do professionals get paid?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After the professional submits hours, the clinic has 24 hours to approve or dispute them; otherwise they are auto-approved. Payment is disbursed within 3 to 5 business days after approval."
      }
    },
    {
      "@type": "Question",
      "name": "What is the 3.9% handling fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A fee of 3.9% of the shift total (hourly rate multiplied by hours) charged to the clinic. It covers card processing, payout administration and transaction oversight."
      }
    },
    {
      "@type": "Question",
      "name": "How far in advance must a professional cancel a shift?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "At least 48 hours before the shift start, on the platform, with a valid reason. Shorter notice or a no-show deactivates booking features immediately. See Cancellation rules."
      }
    },
    {
      "@type": "Question",
      "name": "Can a clinic hire a temp permanently?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, through HR Concierge and the Direct Recruitment Policy, which carries an agency fee. Arranging work off-platform with a Tempfind-connected professional within 12 months breaches the Non-Circumvention Policy. See HR Concierge and Non-circumvention rules."
      }
    },
    {
      "@type": "Question",
      "name": "What is HR Concierge?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An assisted matching service for recurring shifts, short-term contracts and direct hires. Tempfind interviews and shortlists candidates, the clinic interviews and runs a trial shift. It is included in the Business and Enterprise plans."
      }
    },
    {
      "@type": "Question",
      "name": "Where does Tempfind operate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In Canada. The site has dedicated staffing pages for 14 cities in Ontario, Alberta and British Columbia, including Toronto, Ottawa, Calgary, Edmonton and Vancouver. See Service area."
      }
    },
    {
      "@type": "Question",
      "name": "Who can register as a professional?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "People aged 18 or older who are Canadian citizens, legal residents or hold a valid Canadian visa permitting work, and who hold any licensing or certification their profession requires."
      }
    },
    {
      "@type": "Question",
      "name": "Can clinics and professionals chat before a shift?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Tempfind has built-in chat, and clinics can contact a professional before booking."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a mobile app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Tempfind has apps for iOS (App Store) and Android (Google Play)."
      }
    },
    {
      "@type": "Question",
      "name": "How do I contact Tempfind?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Through the contact form at https://tempfind.com/contact-us/ or by email at info@tempfind.com."
      }
    }
  ]
}
